#!/usr/bin/env python3
"""Offline translation helper for the Omarchy plugin.

Language detection (fastText lid.176, ~1 MB) runs in-process and is cheap.
Translation (NLLB-200 via CTranslate2) lives in a server that starts on the
first request and exits after `idleSeconds` without one, so the model only
holds RAM while you are using it.

Commands:
  setup [1.3B|3.3B]   create the venv and download models
  run                 read {"text", "src"?} as one JSON line on stdin, print result JSON
  on-copy             wl-paste --watch handler: popup for non-English clipboard text
  detect              read text on stdin, print detection JSON
  copy                read {"text"} as one JSON line on stdin, put it on the clipboard
  take-open           print and delete the text a popup's "Open" stashed for the overlay
  status | stop | langs | popups on|off
"""

import hashlib
import html
import json
import os
import re
import socket
import subprocess
import sys
import time
import unicodedata
from pathlib import Path

PLUGIN_ID = "io.github.lekonidus.offline-translate"
PLUGIN_DIR = Path(__file__).resolve().parent.parent
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy-offline-translate" / "config.json"
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "omarchy-offline-translate"
VENV_PY = DATA_DIR / "venv" / "bin" / "python"
LID_FILE = DATA_DIR / "models" / "lid.176.ftz"
LID_URL = "https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.ftz"
LID_SHA256 = "8f3472cfe8738a7b6099e8e999c3cbfae0dcd15696aac7d7738a8039db603e83"
MODELS = {
    "1.3B": ("OpenNMT/nllb-200-distilled-1.3B-ct2-int8", "70f572adafa4794890ce7826156a4209717855af"),
    "3.3B": ("OpenNMT/nllb-200-3.3B-ct2-int8", "28d998cc8548ad62f4f98cf8860928c3af99b97b"),
}
MODEL_FILES = ["config.json", "model.bin", "shared_vocabulary.json", "tokenizer.json"]
DEFAULTS = {"model": "1.3B", "modelDir": "", "idleSeconds": 120, "clipboardPopups": True, "minConfidence": 0.5}
MAX_CLIPBOARD = 20_000
MAX_TEXT = 100_000
TARGET = "eng_Latn"

# fastText lid.176 label -> (NLLB-200 code, English name). Labels NLLB cannot
# translate from are left out; they show up as "not supported".
